---
import Layout from '../layouts/doc.astro';
---

<Layout title="Sheet not found" section="Error" folio="404" folioLabel="Error">
  <div class="error-rule"></div>
  <h1>Sheet not found</h1>
  <p class="tagline">
    This drawing is not in the set. Every sheet that is in it is listed in the parts
    catalog, and the manual is in the index to the left.
  </p>
  <a href="/ui/" class="plain error-action">← Parts catalog</a>
  <div class="error-rule"></div>
</Layout>

<style>
  .error-rule {
    border-top: 1px solid var(--color-border-strong);
    margin: 2rem 0 2.5rem;
  }
  .error-rule:last-of-type {
    margin: 3rem 0 0;
  }
  .error-action {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg);
    text-decoration: none;
    border: 1px solid var(--color-border-strong);
  }
  .error-action:hover {
    box-shadow: var(--shadow-offset-action);
  }
  .error-action:active {
    box-shadow: none;
    translate: 1px 1px;
  }
</style>
