---
import Layout from '../layouts/doc.astro';
import { TokenTable } from '../components/token-table';
import themeTokensData from '../data/theme-tokens.json';

const porcelain: Record<string, string> = themeTokensData.porcelain;

/** Map display name (e.g. "--graphite") to CSS value from generated JSON */
function val(name: string): string {
  // Color tokens: --graphite → --color-graphite
  const colorKey = name.replace(/^--/, "--color-");
  if (porcelain[colorKey]) return porcelain[colorKey];
  // Shadow tokens: --shadow-offset → --shadow-offset (same key)
  if (porcelain[name]) return porcelain[name];
  return "";
}

const neutrals = [
  { name: "--graphite", usage: "Deepest tone" },
  { name: "--ink", usage: "Primary text" },
  { name: "--branch", usage: "Brand surfaces" },
  { name: "--iron", usage: "Dark borders" },
  { name: "--slate", usage: "Dark secondary" },
  { name: "--zinc", usage: "Dark muted" },
  { name: "--steel", usage: "Secondary text" },
  { name: "--muted", usage: "Muted text" },
  { name: "--aluminum", usage: "Decorative, shadows" },
  { name: "--chrome", usage: "Primary border" },
  { name: "--silver", usage: "Light border" },
  { name: "--platinum", usage: "Light background" },
  { name: "--frost", usage: "Hover, inputs" },
  { name: "--paper", usage: "Primary background" },
].map(t => ({ ...t, value: val(t.name) }));

const signals = [
  { name: "--signal-blue", usage: "Links, info" },
  { name: "--signal-red", usage: "Error, destructive" },
  { name: "--signal-green", usage: "Success" },
  { name: "--signal-amber", usage: "Warning" },
  { name: "--signal-purple", usage: "Accent" },
  { name: "--signal-cyan", usage: "Info alternate" },
].map(t => ({ ...t, value: val(t.name) }));

const surfaces = [
  { name: "--surface-0", usage: "Page background" },
  { name: "--surface-1", usage: "Cards, panels" },
  { name: "--surface-2", usage: "Nested, elevated" },
].map(t => ({ ...t, value: val(t.name) }));

const shadows = [
  { name: "--shadow-offset", usage: "Default interactive" },
  { name: "--shadow-offset-hover", usage: "Hover" },
  { name: "--shadow-offset-active", usage: "Active/pressed" },
  { name: "--shadow-offset-dark", usage: "Overlays" },
].map(t => ({ ...t, value: val(t.name) }));
---

<Layout title="Design Tokens">

<h1>Design Tokens</h1>

<p>The <code>init</code> command adds design tokens to your CSS file. After initialization, you own them — customize freely. Values shown are Porcelain (default). See <a href="/ui/themes">Themes</a> for other presets.</p>

<h2>Neutral</h2>

<TokenTable tokens={neutrals} />

<p>Use as Tailwind utilities: <code>bg-paper</code>, <code>text-ink</code>, <code>border-chrome</code>, etc.</p>

<h2>Signal Colors</h2>

<TokenTable tokens={signals} />

<p>Each has <code>hover</code> and <code>active</code> variants (e.g., <code>--signal-red-hover</code>). Use as <code>bg-signal-red</code>, <code>text-signal-blue</code>, etc.</p>

<h2>Surface Layers</h2>

<TokenTable tokens={surfaces} />

<h2>Shadows</h2>

<TokenTable tokens={shadows} showSwatch={false} />

<p>Use as <code>shadow-offset</code>, <code>hover:shadow-offset-hover</code>, <code>active:shadow-offset-active</code>. Size and color vary by theme.</p>

<h2>Customization</h2>

<p>After <code>init</code>, these tokens are yours. The library will not update them automatically. Check the <a href="/ui/changelog">Changelog</a> when updating.</p>

</Layout>
