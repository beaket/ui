---
import Layout from '../../layouts/doc.astro';
import CodeBlock from '../../components/code-block.astro';
import PropsTable from '../../components/props-table.astro';
import ExampleSection from '../../components/example-section.astro';
import { StoryPreview } from '../../components/story-preview';
import { InteractiveExample, hasInteractiveExample } from '../../components/interactive-example';
import { getPublicExample } from '../../../../src/examples/registry';
import registry from '../../../../registry/registry.json';
import propsData from '../../generated/props.json';

// Generate static paths for all components
export function getStaticPaths() {
  return registry.components.map((component) => ({
    params: { name: component.name },
    props: { component },
  }));
}

const { component } = Astro.props as { component: (typeof registry.components)[0] };
const { name, docs } = component;
const sections = docs?.sections ?? [];

// Get props for this component
const props = propsData[name as keyof typeof propsData] ?? [];

// Generate import statement
const pascalName = name.charAt(0).toUpperCase() + name.slice(1);
const importCode = `import { ${pascalName} } from "@/components/ui/${name}"`;

// Prepare section data
const sectionData = sections.map((sectionName) => {
  const publicExample = getPublicExample(name, sectionName);
  return {
    storyName: sectionName,
    displayName: sectionName.replace(/([a-z])([A-Z])/g, '$1 $2'),
    source: publicExample?.source ?? '',
  };
});

// Get prev/next components
const currentIndex = registry.components.findIndex((c) => c.name === name);
const prevComponent = currentIndex > 0 ? registry.components[currentIndex - 1] : null;
const nextComponent = currentIndex < registry.components.length - 1 ? registry.components[currentIndex + 1] : null;
---

<Layout title={docs?.title ?? name}>
  <div>
    <!-- Title + Preview -->
    <header>
      <h1>{docs?.title ?? name}</h1>
      <p class="tagline">{docs?.tagline ?? component.description}</p>
      <div class="preview-box mt-2 border border-[var(--color-border-muted)] bg-[var(--color-bg)] p-4">
        {hasInteractiveExample(name, docs?.previewStory) ? (
          <InteractiveExample
            componentName={name}
            storyName={docs?.previewStory}
            client:visible={{ rootMargin: '200px' }}
          />
        ) : (
          <StoryPreview componentName={name} storyName={docs?.previewStory} />
        )}
      </div>
    </header>

    <!-- Install -->
    <section>
      <h2>Install</h2>
      <CodeBlock code={`npx @beaket/ui add ${name}`} lang="bash" />
    </section>

    <!-- Import -->
    <section>
      <h2>Import</h2>
      <CodeBlock code={importCode} />
    </section>

    <!-- Examples -->
    <section>
      <h2>Examples</h2>
      <div class="space-y-4">
        {sectionData.map((section) => (
          <ExampleSection
            componentName={name}
            storyName={section.storyName}
            displayName={section.displayName}
            source={section.source}
          />
        ))}
      </div>
    </section>

    <!-- Props -->
    <section>
      <h2>Props</h2>
      <PropsTable props={props} />
    </section>

    <!-- Prev/Next Navigation -->
    <nav class="component-nav">
      {prevComponent ? (
        <a href={`/ui/components/${prevComponent.name}`} class="component-nav-link">
          ← {prevComponent.docs.title}
        </a>
      ) : <div />}
      {nextComponent ? (
        <a href={`/ui/components/${nextComponent.name}`} class="component-nav-link next">
          {nextComponent.docs.title} →
        </a>
      ) : <div />}
    </nav>
  </div>
</Layout>
