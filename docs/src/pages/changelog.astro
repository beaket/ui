---
import Layout from '../layouts/doc.astro';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('changelog');
const entry = entries[0];
const { Content } = await render(entry);
---

<Layout title="Changelog" section="Reference">
  <h1>Changelog</h1>
  <p>Every notable change to Beaket UI, newest first.</p>

  <div class="changelog-content">
    <Content />
  </div>
</Layout>

<style>
  /* The page already has a title; the changelog file carries its own. */
  .changelog-content :global(h1) {
    display: none;
  }
  /* Releases are the section breaks, so the version heading takes the rule. */
  .changelog-content :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }
  .changelog-content :global(h3) {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-top: 1.25rem;
  }
</style>
