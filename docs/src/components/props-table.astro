---
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/table';

interface PropInfo {
  name: string;
  type: string;
  required: boolean;
  defaultValue: string | null;
  description: string;
}

interface Props {
  props: PropInfo[];
}

const { props } = Astro.props;
---

{props.length === 0 ? (
  <p class="no-props">
    No documented props of its own — it takes the native element's attributes.
  </p>
) : (
  <div class="props-table">
    <Table scrollLabel="Props">
      <TableHeader>
        <TableRow>
          <TableHead scope="col">Name</TableHead>
          <TableHead scope="col">Type</TableHead>
          <TableHead scope="col">Default</TableHead>
          <TableHead scope="col">Description</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {props.map((p) => (
          <TableRow>
            <TableCell className="prop-name">
              {p.name}{p.required && <span class="required" title="Required">*</span>}
            </TableCell>
            <TableCell className="prop-type" data-label="Type">{p.type}</TableCell>
            <TableCell className="prop-default" data-label="Default">{p.defaultValue ?? '—'}</TableCell>
            <TableCell className="prop-description" data-label="Description">{p.description || '—'}</TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  </div>
)}

<style is:global>
  .no-props {
    color: var(--color-fg-muted);
  }

  /* The component owns the table's chrome; these are the docs-only concerns
     the component cannot know about — which column carries code, and how a
     reference table survives a phone. */
  .props-table [data-slot="table-cell"] {
    vertical-align: top;
  }
  .props-table .prop-name,
  .props-table .prop-type,
  .props-table .prop-default {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .props-table .prop-name {
    font-weight: 600;
    color: var(--color-fg);
    white-space: nowrap;
  }
  .props-table .prop-type {
    width: 28%;
    color: var(--color-fg-muted);
    overflow-wrap: break-word;
  }
  .props-table .prop-default {
    color: var(--color-fg);
    white-space: nowrap;
  }
  .props-table .prop-description {
    width: 44%;
    color: var(--color-fg-muted);
  }
  .props-table .required {
    color: var(--color-danger-fg);
    margin-left: 0.125rem;
  }

  @media (max-width: 767px) {
    .props-table [data-slot="table"],
    .props-table [data-slot="table-body"],
    .props-table [data-slot="table-row"],
    .props-table [data-slot="table-cell"] {
      display: block;
      width: auto;
      min-width: 0;
    }
    .props-table [data-slot="table-header"] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .props-table [data-slot="table-row"] {
      padding: 0.875rem 0;
    }
    .props-table [data-slot="table-cell"] {
      padding: 0.125rem 0;
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0 0.75rem;
      width: auto;
    }
    .props-table [data-slot="table-cell"][data-label]::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--color-fg-subtle);
    }
    .props-table .prop-name {
      display: block;
      font-size: var(--text-sm);
      margin-bottom: 0.375rem;
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .props-table .prop-default {
      white-space: normal;
    }
  }
</style>
