---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: 'tsx' | 'bash' | 'css' | 'js';
}

const { code, lang = 'tsx' } = Astro.props;
---

<div class="overflow-x-auto font-mono text-[13px] [&_pre]:p-3">
  <Code code={code} lang={lang} theme="css-variables" />
</div>
