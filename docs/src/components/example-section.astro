---
import CodeBlock from './code-block.astro';
import { StoryPreview, needsSizedStage } from './story-preview';
import { InteractiveExample, hasInteractiveExample } from './interactive-example';

interface Props {
  componentName: string;
  storyName: string;
  displayName: string;
  source: string;
}

const { componentName, storyName, displayName, source } = Astro.props;
const slug = `${componentName}-${storyName.toLowerCase()}`;
---

<figure class="figure">
  <h3 class="figure-title" id={slug}>{displayName}</h3>

  <div class="preview-box stage" data-stage={needsSizedStage(componentName, storyName) ? 'sized' : undefined}>
    {hasInteractiveExample(componentName, storyName) ? (
      <InteractiveExample
        componentName={componentName}
        storyName={storyName}
        client:visible={{ rootMargin: '200px' }}
      />
    ) : (
      <StoryPreview componentName={componentName} storyName={storyName} />
    )}
  </div>

  {source && (
    <details class="listing" open>
      <summary>Source</summary>
      <CodeBlock code={source} />
    </details>
  )}
</figure>
