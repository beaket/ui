---
import CodeBlock from './code-block.astro';
import { StoryPreview } from './story-preview';
import { InteractiveExample } from './interactive-example';
import { getPublicExample } from '../../../src/examples/registry';

interface Props {
  componentName: string;
  storyName: string;
  displayName: string;
  source: string;
}

const { componentName, storyName, displayName, source } = Astro.props;
const publicExample = getPublicExample(componentName, storyName);
---

<div>
  <h3>{displayName}</h3>
  <div class="preview-box mt-2 border border-[var(--color-border-muted)] bg-[var(--color-bg)] p-4">
    {publicExample?.hydration === 'visible' ? (
      <InteractiveExample
        componentName={componentName}
        storyName={storyName}
        client:visible={{ rootMargin: '200px' }}
      />
    ) : (
      <StoryPreview componentName={componentName} storyName={storyName} />
    )}
  </div>
  {source && (
    <div class="mt-2">
      <CodeBlock code={source} />
    </div>
  )}
</div>
