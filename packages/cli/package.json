{
  "name": "@beaket/ui",
  "version": "4.2.1",
  "description": "React + Tailwind components you own outright: the CLI copies the source into your project, with a committed visual identity instead of a neutral default.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "bin": {
    "ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "cli",
    "copy-paste",
    "component-library",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beaket/ui"
  },
  "dependencies": {
    "commander": "15.0.0",
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^9.0.0"
  }
}
