{
  "name": "@beaket/ui",
  "version": "1.9.1",
  "description": "CLI tool for adding Beaket UI components to your project",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "bin": {
    "ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beaket/ui"
  },
  "dependencies": {
    "commander": "14.0.3",
    "fs-extra": "11.3.3",
    "picocolors": "1.1.1",
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1"
  }
}
